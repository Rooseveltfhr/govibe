APP_NAME="GOVIBE Innovation Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://govibeht.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=govibe_prod
DB_USERNAME=govibe_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

# LAISSER VIDE. C'est ce réglage, et lui seul, qui lie le cookie de session à
# l'hôte qui l'a posé. Mettre « .govibeht.com » ici enverrait le cookie du
# back-office au site public, et toute la séparation des domaines ne servirait
# plus à rien.
SESSION_DOMAIN=null

# Le cookie n'est transmis qu'en HTTPS. À activer dès que le certificat est en
# place : sans cela, une seule requête en clair suffit à exposer une session.
SESSION_SECURE_COOKIE=true

# ── Séparation des domaines ───────────────────────────────────────────────
# Tant que cette valeur est vide, l'ERP et le portail répondent sur n'importe
# quel domaine — c'est le comportement par défaut, et rien ne casse.
# Ne la renseigner QUE lorsque le sous-domaine résout, possède son vhost et son
# certificat : une isolation posée trop tôt enfermerait l'équipe dehors de son
# propre ERP.
GOVIBE_DOMAINE_APP=
GOVIBE_DOMAINE_VITRINE=govibeht.com

# Durée en jours pendant laquelle le navigateur s'interdira le HTTP clair.
# 0 = désactivé. Commencer à 1 ou 7, vérifier, puis allonger : la consigne reste
# en mémoire du navigateur pendant toute la durée annoncée, même si un
# certificat expire entre-temps.
GOVIBE_HSTS_JOURS=0

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=govibeht@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="govibeht@gmail.com"
MAIL_FROM_NAME="GOVIBE Innovation Hub"

VITE_APP_NAME="${APP_NAME}"

# ── WhatsApp notifications ───────────────────────────────────────────────────
# Drivers: log (dev) | callmebot (free) | twilio (production)
WHATSAPP_DRIVER=log
CALLMEBOT_API_KEY=

# Twilio (production WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=+1XXXXXXXXXX
